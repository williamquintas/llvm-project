; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=aarch64-none-linux-gnu -mattr=+sve %s -o - | FileCheck %s

; The number of lanes is unknown, so the reduction may set bits above bit 9.
define i32 @reduce_add_scalable(<vscale x 4 x i32> %x) {
; CHECK-LABEL: reduce_add_scalable:
; CHECK:       // %bb.0:
; CHECK-NEXT:    and z0.s, z0.s, #0xff
; CHECK-NEXT:    ptrue p0.s
; CHECK-NEXT:    uaddv d0, p0, z0.s
; CHECK-NEXT:    fmov w8, s0
; CHECK-NEXT:    and w0, w8, #0x3ff
; CHECK-NEXT:    ret
  %masked = and <vscale x 4 x i32> %x, splat (i32 255)
  %sum = call i32 @llvm.vector.reduce.add.nxv4i32(<vscale x 4 x i32> %masked)
  %result = and i32 %sum, 1023
  ret i32 %result
}
